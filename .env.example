# Public site settings. All optional; see README.
NEXT_PUBLIC_SITE_URL=https://lawbid.app
# Only when the site is served from a sub-path, e.g. /LawBidSite on GitHub Pages.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@lawbid.app
# Prices from the LawBid admin: the API base (…/api/v1) or its /pricing address.
# Unset = the committed src/content/pricing.json. See scripts/fetch-pricing.mjs.
PRICING_API_URL=
# Optional: file with the prices of the last successful build (fallback when the API is down).
PRICING_LAST_KNOWN=
